# Copy to .env.local and fill in real values.

# --- Supabase (client + server auth) ---
# Also used server-side to verify the access token on AI endpoints.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to "true" to expose the sign-up page.
NEXT_PUBLIC_ENABLE_SIGNUP=false

# --- Google Gemini (Table Topics question generator) ---
# Server-only. Without it, /generate-topics returns 503 and the
# "Generate Questions" button reports that generation is not configured.
# Must also be set in the Vercel project's environment variables.
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the Gemini model used for topic generation.
# GEMINI_MODEL=gemini-2.0-flash
